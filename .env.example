# DevFlow environment variables. Copy to .env.local for development; set the same names in your host for production.
# Check yours any time with:  npm run check:env      (it never prints a secret)

# ── Required ───────────────────────────────────────────────────────────────
# Neon connection string. Use the POOLED one (host contains -pooler) and keep ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require

# Signs sessions. 32+ random characters:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Encrypts saved credentials (API keys, webhook URLs). 32 random bytes, base64:  openssl rand -base64 32
# BACK THIS UP. If it is lost, every saved credential becomes unreadable.
CREDENTIALS_KEY=

# The public address of the app (https in production). Email links and origin checks are built from it.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b      # optional: override the primary model

# ── Scheduler ──────────────────────────────────────────────────────────────
# Authenticates whatever calls /api/cron/tick every minute (Vercel Cron, GitHub Actions, cron-job.org...)
CRON_SECRET=

# ── Email (optional but recommended) ───────────────────────────────────────
# With BOTH set, new accounts must verify their email and "Forgot password?" works. Use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="DevFlow <noreply@yourdomain.com>"

# Development only: print auth emails to the server log instead of sending them (refused in production)
# AUTH_EMAIL_MODE=console

# ── Legal pages (shown on /privacy and /terms) ─────────────────────────────
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
